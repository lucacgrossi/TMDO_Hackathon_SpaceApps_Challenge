# Copiar a .env.local. Sin estas variables, el front usa el mock.
# true = datos falsos (src/mocks/analizar.ts) · false = API real
NEXT_PUBLIC_USAR_MOCK=true
# URL del backend, sin barra final. Local: http://localhost:8000
# Cloud Run: https://field-shift-api-757348191517.southamerica-east1.run.app
# El back acepta pedidos desde http://localhost:3000 y *.vercel.app (CORS).
NEXT_PUBLIC_API_URL=http://localhost:8000
